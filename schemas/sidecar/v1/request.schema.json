{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mardas.dev/schemas/sidecar/v1/request.schema.json",
  "title": "Mardas Sidecar JSON-RPC Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["jsonrpc", "id", "method"],
  "properties": {
    "jsonrpc": {"const": "2.0"},
    "id": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "integer"}]},
    "method": {
      "enum": [
        "system.health",
        "system.capabilities",
        "system.shutdown",
        "job.cancel",
        "render.document",
        "render.book",
        "preview.document",
        "validate.document",
        "validate.book"
      ]
    },
    "params": {"type": "object"}
  }
}
