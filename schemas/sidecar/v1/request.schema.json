{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mardas.dev/schemas/sidecar/v1/request.schema.json",
  "title": "Mardas Sidecar JSON-RPC Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jsonrpc",
    "id",
    "method"
  ],
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "id": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "integer"
        }
      ]
    },
    "method": {
      "enum": [
        "system.health",
        "system.capabilities",
        "system.shutdown",
        "job.cancel",
        "document.read",
        "document.save",
        "document.list_assets",
        "document.import_asset",
        "project.open",
        "project.refresh",
        "project.read",
        "project.save",
        "project.search",
        "bibliography.index",
        "book.create",
        "book.add_chapter",
        "book.duplicate_chapter",
        "book.reorder_chapters",
        "book.remove_chapter",
        "book.validate",
        "book.preview",
        "book.export",
        "render.document",
        "render.book",
        "preview.document",
        "preview.document_text",
        "validate.document",
        "validate.document_text",
        "validate.book"
      ]
    },
    "params": {
      "type": "object"
    }
  }
}
