{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mardas Folio",
  "version": "1.31.0",
  "identifier": "io.github.mragetsars.mardas-studio",
  "mainBinaryName": "mardas-folio",
  "build": {
    "beforeBuildCommand": "python ../../scripts/build_desktop_frontend.py",
    "frontendDist": "../dist",
    "additionalWatchFolders": [
      "../frontend"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mardas Folio",
        "width": 1240,
        "height": 820,
        "minWidth": 840,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "decorations": true,
        "backgroundColor": "#f2f2f2"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; object-src 'none'; base-uri 'none'",
      "freezePrototype": true,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Productivity",
    "publisher": "mragetsars",
    "shortDescription": "Persian and English Markdown publishing studio",
    "longDescription": "Mardas Folio converts Persian and English Markdown into publication-ready PDF with RTL typography, MathJax, Mermaid, citations, and PDF navigation.",
    "homepage": "https://github.com/mragetsars/Mardas-MD2PDF",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/sidecar/": "sidecar/"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "description": "Markdown document published with Mardas Folio",
        "mimeType": "text/markdown",
        "role": "Editor",
        "rank": "Alternate"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
