{
  "bundle": {
    "targets": [
      "nsis"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "displayLanguageSelector": false,
        "compression": "lzma",
        "installMode": "currentUser"
      }
    }
  }
}
