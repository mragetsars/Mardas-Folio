{
  "name": "mardas-folio-desktop",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:editor": "node scripts/build-editor.mjs",
    "check:editor": "node scripts/build-editor.mjs --check",
    "test": "node scripts/test.mjs",
    "lint": "eslint frontend/js editor-src scripts tests eslint.config.mjs",
    "format": "prettier --write \"frontend/js/**/*.mjs\" \"frontend/{design,styles}/**/*.css\" \"editor-src/**/*.mjs\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \"*.config.mjs\"",
    "format:check": "prettier --check \"frontend/js/**/*.mjs\" \"frontend/{design,styles}/**/*.css\" \"editor-src/**/*.mjs\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \"*.config.mjs\""
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.8",
    "codemirror": "6.0.2"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "eslint": "10.15.0",
    "globals": "16.5.0",
    "prettier": "3.10.1"
  }
}
