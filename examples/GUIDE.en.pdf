<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description rdf:about=""
      xmlns:dc="http://purl.org/dc/elements/1.1/"
      xmlns:pdf="http://ns.adobe.com/pdf/1.3/"
      xmlns:xmp="http://ns.adobe.com/xap/1.0/">
      <dc:format>application/pdf</dc:format>
      <dc:title><rdf:Alt><rdf:li xml:lang="x-default">Mardas MD2PDF Guide</rdf:li></rdf:Alt></dc:title>
      <dc:creator><rdf:Seq><rdf:li>Mardas MD2PDF Team (Documentation)ØŒ Meraj Rastegar (mragetsars@gmail.com)</rdf:li></rdf:Seq></dc:creator>
      <dc:description><rdf:Alt><rdf:li xml:lang="x-default">A complete guide for installing, configuring, and using Mardas MD2PDF.
This document also acts as a live rendering sample for cover pages, tables of contents, mixed RTL/LTR text, formulas, code, Mermaid flowcharts, images, tables, footnotes, page breaks, and safe HTML.
</rdf:li></rdf:Alt></dc:description>
      <dc:language><rdf:Bag><rdf:li>en</rdf:li></rdf:Bag></dc:language>
      <pdf:Producer>Mardas MD2PDF + Playwright/Chromium + pypdf</pdf:Producer>
      <pdf:Keywords>Markdown, PDF, Persian/English, RTL/LTR, MathJax</pdf:Keywords>
      <xmp:CreatorTool>Mardas MD2PDF</xmp:CreatorTool>
      <xmp:CreateDate>2025-01-01T00:00:00+00:00</xmp:CreateDate>
      <xmp:ModifyDate>2025-01-01T00:00:00+00:00</xmp:ModifyDate>
    </rdf:Description>
  </rdf:RDF>
</x:xmpmeta>
